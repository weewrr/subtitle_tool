# Subtitle Tool 环境变量示例
# 复制本文件为实际环境后按需填写：
#   - 后端读取以下环境变量（backend/config/settings.py 与 backend/services/translation_service.py）
#   - 前端 VITE_* 变量请写入 frontend/.env*（由 Vite 加载）

# ---- 后端（Flask）----

# 后端服务端口，默认 5000
SUBTITLE_TOOL_BACKEND_PORT=5000

# 设为 1 启用 Flask 调试模式
SUBTITLE_TOOL_BACKEND_DEBUG=0

# 翻译的视频时长软约束开关，设为 0 / false / no / off 关闭
TRANSLATION_DURATION_CONSTRAINT_ENABLED=true

# ---- 翻译引擎 Key（也可在应用内翻译窗口直接填写）----
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
BAILIAN_API_KEY=

# ---- 前端（Vite，写入 frontend/.env*）----
VITE_API_BASE_URL=http://localhost:5000
VITE_APP_TITLE=字幕编辑工具
